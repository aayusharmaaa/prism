# Copy to .env.local and fill in.

# Without this the app runs a scripted demo agent that still executes REAL tool
# calls against the workspace — useful for demos and e2e tests. Set it to get
# real model output.
ANTHROPIC_API_KEY=

# Local file by default. Point at Turso (or any libSQL server) for production;
# nothing in the code changes.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
